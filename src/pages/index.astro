---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Cta from "../components/Cta.astro";
import DemoVideo from "../components/DemoVideo.astro";
import { GAMES, LINKS } from "../data/site.js";
---
<Base
  title="Fattah Widjaya Gandhi | SQA Engineer"
  description="Fattah Widjaya Gandhi: SQA Engineer growing into test automation, and Studio Director for Roblox games at Lawak Studio."
>
  <section class="container hero">
    <div data-reveal>
      <p class="kicker">SQA Engineer &middot; Studio Director</p>
      <h1>Fattah Widjaya Gandhi<span>I test software for a living and build Roblox games on the side.</span></h1>
      <p class="lead">I work as an SQA Engineer on web and mobile apps, and I build my automation in public:
        a Playwright and Bruno suite tests this site before every deploy. Outside work, I lead Roblox game projects
        at Lawak Studio.</p>
      <div class="btn-row">
        <a class="btn primary" href="/experience">View experience<Icon name="i-arrow-right" /></a>
        <a class="btn" href={LINKS.cv} download="CV-Fattah Widjaya Gandhi.pdf"><Icon name="i-file-down" />Download CV</a>
        <a class="btn" href="/projects"><Icon name="i-gamepad-2" />Play my games</a>
      </div>
    </div>
    <div class="raised portrait" data-reveal>
      <img src="/assets/img/github-avatar.webp" alt="Portrait of Fattah Widjaya Gandhi" width="320" height="320" />
      <span class="status"><span class="dot" aria-hidden="true"></span>Playwright + Bruno in CI</span>
    </div>
  </section>

  <section class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker">What I do</p>
        <h2 class="section-title">From QA to automation, plus games</h2>
        <p class="section-sub">Three areas, in the order where most of my time goes.</p>
      </div>
    </div>
    <div class="path" data-reveal data-stagger>
      <a class="raised path-card" href="/experience">
        <span class="badge"><Icon name="i-shield-check" class="icon icon-lg" /></span>
        <span class="step">01 &middot; Career</span>
        <h3>QA / SQA engineering</h3>
        <p>Manual, functional, regression, SIT, UAT, and API testing for web and mobile applications.</p>
        <span class="more">Experience<Icon name="i-arrow-right" /></span>
      </a>
      <a class="raised path-card" href="/about#focus">
        <span class="badge"><Icon name="i-workflow" class="icon icon-lg" /></span>
        <span class="step">02 &middot; Growing</span>
        <h3>Automation &amp; modern testing</h3>
        <p>UI and API automation with Playwright and Bruno that runs in CI, with AI agents working under rules I set.</p>
        <span class="more">Current focus<Icon name="i-arrow-right" /></span>
      </a>
      <a class="raised path-card game" href="/projects">
        <span class="badge game"><Icon name="i-gamepad-2" class="icon icon-lg" /></span>
        <span class="step">03 &middot; Side project</span>
        <h3>Roblox game development</h3>
        <p>As Studio Director at Lawak Studio, I take game ideas from first concept to playtest with the team.</p>
        <span class="more">Projects<Icon name="i-arrow-right" /></span>
      </a>
    </div>
  </section>

  <section class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker">Featured QA work</p>
        <h2 class="section-title">Automation you can check</h2>
        <p class="section-sub">This site is my test subject. The suite runs in GitHub Actions, and a failing test stops the deploy.</p>
      </div>
    </div>
    <div class="featured-qa raised" data-reveal>
      <DemoVideo slug="qa-playwright" caption="The smoke test from the suite, recorded in Microsoft Edge." />
      <ul class="proof-list">
        <li>
          <span class="badge"><Icon name="i-monitor" class="icon icon-lg" /></span>
          <div><h3>End-to-end with Playwright</h3><p>Navigation, links, contact actions, and phone layouts, on desktop and mobile browsers.</p></div>
        </li>
        <li>
          <span class="badge"><Icon name="i-braces" class="icon icon-lg" /></span>
          <div><h3>HTTP checks with Bruno</h3><p>Status codes, content types, clean URLs, and the 404 page, run from the Bruno CLI.</p></div>
        </li>
        <li>
          <span class="badge"><Icon name="i-shield-check" class="icon icon-lg" /></span>
          <div><h3>Accessibility with axe</h3><p>Every page is scanned for serious accessibility problems before release.</p></div>
        </li>
        <li class="proof-links">
          <a class="btn small primary" href={LINKS.report}><Icon name="i-list-checks" />Latest test report</a>
          <a class="btn small" href={LINKS.tests} target="_blank" rel="noopener"><Icon name="b-github" />View the tests</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker game">Lawak Studio</p>
        <h2 class="section-title">Games we made</h2>
      </div>
      <a class="text-link game" href="/projects">All projects<Icon name="i-arrow-right" /></a>
    </div>
    <div class="mini-games" data-reveal data-stagger>
      {GAMES.map((g) => (
        <a class="raised mini-game" href={`/projects#${g.slug}`}>
          <img src={`/assets/img/${g.slug}-icon.webp`} alt="" width="52" height="52" loading="lazy" />
          <span>{g.name}</span>
        </a>
      ))}
    </div>
  </section>

  <Cta title="Want to talk about QA or a game idea?" text="Email is the fastest way to reach me." href="/contact" label="Contact me" />
</Base>
