---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Cta from "../components/Cta.astro";
import { FOCUS } from "../data/site.js";
---
<Base title="About | Fattah Widjaya Gandhi" description="About Fattah: SQA Engineer with 2.5+ years in banking, insurance, and enterprise QA, now building automation with Playwright and Bruno.">
  <section class="container">
    <h1 class="page-title">Hi, I'm Fattah.</h1>
    <p class="lead">I'm an SQA Engineer with 2.5+ years of testing banking, insurance, and enterprise applications. I plan
      and design tests, run SIT, UAT, regression, API, and performance testing, and often own QA on a project as the
      independent tester.</p>
    <p class="lead">I've automated with UFT One at work, and with Selenium, Serenity BDD, Rest Assured, and Appium in my
      bootcamp projects. Now I'm building with Playwright and Bruno in CI. On the side, I lead Roblox game projects at
      Lawak Studio.</p>
  </section>

  <section class="container">
    <div>
      <p class="kicker">How I work</p>
      <h2 class="section-title">What shapes my work</h2>
      <p class="section-sub">A short look at the habits behind my QA work and my game projects.</p>
    </div>
    <dl class="raised habits">
      <div><dt>Testing across the cycle</dt><dd>Functional, regression, SIT, and UAT testing on web and mobile, plus API testing.</dd></div>
      <div><dt>Independent QA</dt><dd>I often own QA on a project and coordinate testing with development and business requirements.</dd></div>
      <div class="game"><dt>Product thinking from games</dt><dd>Directing Roblox projects teaches me to think about player experience, scope, and teamwork.</dd></div>
    </dl>
  </section>

  <section class="container" id="focus">
    <div>
      <p class="kicker">Current focus</p>
      <h2 class="section-title">What I'm working on now</h2>
      <p class="section-sub">Where I'm putting my learning time this year.</p>
    </div>
    <div class="grid-2 focus-list">
      {FOCUS.map((f) => (
        <div class="raised focus-item">
          <span class={`badge${f.game ? " game" : ""}`}><Icon name={f.icon} class="icon icon-lg" /></span>
          <div><h3>{f.title}</h3><p>{f.text}</p></div>
        </div>
      ))}
    </div>
  </section>

  <Cta title="See the details" text="My responsibilities, tools, and skills are on the Experience page." href="/experience" label="View experience" />
</Base>
