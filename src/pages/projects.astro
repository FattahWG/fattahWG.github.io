---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Chips from "../components/Chips.astro";
import Cta from "../components/Cta.astro";
import { GAMES, LINKS } from "../data/site.js";
---
<Base title="Projects | Fattah Widjaya Gandhi" description="Public test automation work, and the Roblox games Fattah directs at Lawak Studio.">
  <section class="container" data-reveal>
    <p class="kicker">Projects</p>
    <h1 class="page-title">Projects</h1>
    <p class="lead">Test automation that you can open and check, and the Roblox games I direct at Lawak Studio.</p>
  </section>

  <section class="container">
    <div data-reveal>
      <p class="kicker">QA &amp; automation</p>
      <h2 class="section-title">Testing work</h2>
      <p class="section-sub">Real suites with real results. The portfolio itself is the system under test.</p>
    </div>
    <div class="grid-2" data-reveal data-stagger>
      <article class="raised card repo-card" id="portfolio-tests">
        <span class="badge"><Icon name="i-shield-check" class="icon icon-lg" /></span>
        <h3>Portfolio test suite</h3>
        <dl class="case-facts">
          <div><dt>Objective</dt><dd>Check the key visitor flows and quality rules before every deploy.</dd></div>
          <div><dt>Coverage</dt><dd>Smoke path, navigation, links, CV download, contact actions, phone layouts, accessibility, and HTTP status codes.</dd></div>
          <div><dt>Stack</dt><dd>Playwright on desktop and mobile profiles, axe, and a Bruno collection.</dd></div>
          <div><dt>CI</dt><dd>GitHub Actions runs every push. A failing test blocks the deploy, and the reports are published.</dd></div>
        </dl>
        <Chips items={["Playwright", "Bruno", "axe", "GitHub Actions"]} />
        <div class="btn-row">
          <a class="btn small primary" href={LINKS.report}><Icon name="i-list-checks" />Playwright report</a>
          <a class="btn small" href={LINKS.apiReport}><Icon name="i-braces" />Bruno report</a>
          <a class="btn small" href={LINKS.tests} target="_blank" rel="noopener"><Icon name="b-github" />View the tests</a>
        </div>
      </article>
      <article class="raised card repo-card">
        <span class="badge"><Icon name="i-folder-kanban" class="icon icon-lg" /></span>
        <h3>Automations Test Preset</h3>
        <p>A workflow preset, not a framework: setup guides, test case structure, reporting conventions, and the rules
          that AI agents follow when they work with me. The working automation lives in the portfolio test suite.</p>
        <Chips items={["Playwright", "Bruno CLI", "Claude Code"]} />
        <a class="btn small" href={LINKS.preset} target="_blank" rel="noopener"><Icon name="b-github" />View on GitHub</a>
      </article>
    </div>
  </section>

  <section class="container">
    <div data-reveal>
      <p class="kicker game">Roblox games</p>
      <h2 class="section-title">Games at Lawak Studio</h2>
      <p class="section-sub">Lawak Studio publishes its games under the Lawak Gamehouse community on Roblox. I direct these
        projects with our programmers, level designers, and 3D artists.</p>
    </div>
    <div class="grid-2" data-reveal data-stagger>
      {GAMES.map((g) => (
        <article class="raised game-card" id={g.slug}>
          <div class="cover">
            <img src={`/assets/img/${g.slug}-cover.webp`} alt={`${g.name} thumbnail`} width="768" height="432" loading="lazy" />
          </div>
          <div class="game-body">
            <div class="game-title">
              <img src={`/assets/img/${g.slug}-icon.webp`} alt="" width="40" height="40" loading="lazy" />
              <h3>{g.name}</h3>
            </div>
            <p>{g.text}</p>
            <Chips items={g.chips} />
            <div class="actions">
              <a class="btn game small" href={g.url} target="_blank" rel="noopener"><Icon name="i-play" />Play on Roblox</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container" data-reveal>
    <div class="raised community">
      <img src="/assets/img/lawak-gamehouse.webp" alt="Lawak Gamehouse logo" width="84" height="84" loading="lazy" />
      <div>
        <h3>Lawak Gamehouse</h3>
        <p>Play. Explore. Have fun. The Roblox community where Lawak Studio games live.</p>
      </div>
      <div class="btn-row">
        <a class="btn small" href={LINKS.group} target="_blank" rel="noopener"><Icon name="b-roblox" />Community</a>
        <a class="btn small" href={LINKS.discord} target="_blank" rel="noopener"><Icon name="b-discord" />Discord</a>
      </div>
    </div>
  </section>

  <Cta title="Like what you see?" text="Say hi, or join the Lawak Gamehouse Discord." href="/contact" label="Contact me" />
</Base>
