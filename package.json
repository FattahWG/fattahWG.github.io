{
  "name": "fattahwg-portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/frontend",
    "build": "npm run build -w apps/frontend",
    "preview": "npm run preview -w apps/frontend",
    "typecheck": "npm run typecheck -w apps/frontend && npm run typecheck -w apps/backend",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "cd tests/api && bru run --env local -r",
    "test:api:prod": "cd tests/api && bru run --env production -r"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.55.1",
    "@usebruno/cli": "4.1.0"
  }
}
