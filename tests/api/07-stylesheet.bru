tests {
  test("TC-HTTP-007: returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("TC-HTTP-007: is served as text/css", function () {
    expect(res.getHeader("content-type")).to.contain("text/css");
  });
}
