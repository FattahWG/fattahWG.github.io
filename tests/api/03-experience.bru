meta {
  name: Experience at a clean URL
  type: http
  seq: 3
  tags: [
    smoke
  ]
}

get {
  url: {{baseURL}}/experience
  body: none
  auth: none
}

tests {
  test("TC-HTTP-003: returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("TC-HTTP-003: is an HTML page", function () {
    expect(res.getHeader("content-type")).to.contain("text/html");
  });
  test("TC-HTTP-003: has the expected title", function () {
    expect(res.getBody()).to.contain("<title>Experience | Fattah Widjaya Gandhi</title>");
  });
  test("TC-HTTP-003: canonical URL has no .html", function () {
    expect(res.getBody()).to.not.match(/rel="canonical" href="[^"]*\.html"/);
  });
}
