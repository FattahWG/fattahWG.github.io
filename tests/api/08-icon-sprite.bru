tests {
  test("TC-HTTP-008: returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("TC-HTTP-008: is served as image/svg+xml", function () {
    expect(res.getHeader("content-type")).to.contain("image/svg+xml");
  });
}
