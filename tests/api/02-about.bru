meta {
  name: About at a clean URL
  type: http
  seq: 2
  tags: [
    smoke
  ]
}

get {
  url: {{baseURL}}/about
  body: none
  auth: none
}

tests {
  test("TC-HTTP-002: returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("TC-HTTP-002: is an HTML page", function () {
    expect(res.getHeader("content-type")).to.contain("text/html");
  });
  test("TC-HTTP-002: has the expected title", function () {
    expect(res.getBody()).to.contain("<title>About | Fattah Widjaya Gandhi</title>");
  });
  test("TC-HTTP-002: canonical URL has no .html", function () {
    expect(res.getBody()).to.not.match(/rel="canonical" href="[^"]*\.html"/);
  });
}
